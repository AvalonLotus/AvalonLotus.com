#!/usr/bin/env bash
#
# avalonlotus.com/mac — bootstrap a Mac into AvalonLotus Demesne.
#
# This file used to be a copy of install.sh and drifted 258 lines behind it,
# so a fresh Mac running the one-liner got an installer from months earlier.
# It fetches the real one now and never goes stale again.
#
# Run it as:
#     bash <(curl -fsSL avalonlotus.com/mac)
#
# not `curl … | bash` — piping hands the script itself to stdin, and gh's
# sign-in prompt then has nothing to read from.
#
set -euo pipefail

REPO_URL="https://github.com/AvalonLotus/AvalonLotus-Demesne.git"
REPO_DIR="$HOME/AvalonLotus Demesne"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log()  { printf "${GREEN}▶${NC} %s\n" "$*"; }
warn() { printf "${YELLOW}!${NC} %s\n" "$*"; }

if ! command -v git >/dev/null 2>&1; then
  log "Installing the Xcode command line tools (git comes with them)"
  xcode-select --install 2>/dev/null || true
  warn "Re-run this once the installer window finishes."
  exit 1
fi

if [ -d "$REPO_DIR/.git" ]; then
  log "Updating $REPO_DIR"
  git -C "$REPO_DIR" pull --rebase --autostash --quiet || warn "pull failed — using the local copy"
else
  # The repo is private: it carries the global operating rules and the git
  # identity. Cloning it needs credentials, and gh is the way this account
  # supplies them everywhere else.
  if ! command -v gh >/dev/null 2>&1; then
    if command -v brew >/dev/null 2>&1; then
      log "Installing gh"
      brew install gh
    else
      log "Installing Homebrew first"
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      for p in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$p" ] && eval "$("$p" shellenv)"
      done
      brew install gh
    fi
  fi

  if ! gh auth status >/dev/null 2>&1; then
    log "Signing in to GitHub — choose GitHub.com, HTTPS, then the browser flow"
    gh auth login
  fi

  log "Cloning into $REPO_DIR"
  gh repo clone AvalonLotus/AvalonLotus-Demesne "$REPO_DIR"
fi

log "Handing over to install.sh"
exec bash "$REPO_DIR/install.sh"
